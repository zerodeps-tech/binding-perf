+enum class SnapshotAblationMode {
+    Production,
+    Static,
+    Shape,
+    Names,
+    Method,
+    Url,
+    Query,
+    Headers,
+    Params,
+};
+
+SnapshotAblationMode ReadSnapshotAblationMode() {
+    const char *value = std::getenv("SWM_UWS_SNAPSHOT_ABLATION");
+    if (!value || !*value || std::strcmp(value, "production") == 0) {
+        return SnapshotAblationMode::Production;
+    }
+    if (std::strcmp(value, "static") == 0) return SnapshotAblationMode::Static;
+    if (std::strcmp(value, "shape") == 0) return SnapshotAblationMode::Shape;
+    if (std::strcmp(value, "names") == 0) return SnapshotAblationMode::Names;
+    if (std::strcmp(value, "method") == 0) return SnapshotAblationMode::Method;
+    if (std::strcmp(value, "url") == 0) return SnapshotAblationMode::Url;
+    if (std::strcmp(value, "query") == 0) return SnapshotAblationMode::Query;
+    if (std::strcmp(value, "headers") == 0) return SnapshotAblationMode::Headers;
+    if (std::strcmp(value, "params") == 0) return SnapshotAblationMode::Params;
+    return SnapshotAblationMode::Production;
+}
+
+bool SnapshotModeAtLeast(
+    SnapshotAblationMode actual,
+    SnapshotAblationMode expected) {
+    return static_cast<int>(actual) >= static_cast<int>(expected);
+}
